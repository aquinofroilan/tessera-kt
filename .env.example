# .env.example

# Application Configuration
APP_NAME=tessera
SERVER_PORT=8080
SERVER_CONTEXT_PATH=/api
APP_VERSION=0.0.1-SNAPSHOT
APP_DESCRIPTION=Tessera an ERP System
APP_ENVIRONMENT=development

# Database Configuration
# Format: mongodb://<username>:<password>@host:port/database?authSource=admin
# Note: Special characters in password must be URL-encoded (e.g., & = %26, * = %2A)
# Credentials should be embedded in the URI, not as separate properties
MONGODB_URI=mongodb://<username>:<password>@127.0.0.1:27017/tessera

# Security Configuration
JWT_SECRET=your-secret-key-here-change-in-production
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=2592000000

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Logging Configuration
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_TESSERA=INFO
LOG_LEVEL_ASPECT=DEBUG
LOG_LEVEL_SECURITY=DEBUG
LOG_LEVEL_MONGODB=DEBUG

# Management/Actuator Configuration
MANAGEMENT_ENDPOINTS_INCLUDE=health,info,metrics
MANAGEMENT_HEALTH_SHOW_DETAILS=when-authorized
