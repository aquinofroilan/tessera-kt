# Force LF line endings for all text files
* text=auto eol=lf

# Ensure these are always treated as text with LF
*.kt text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.properties text eol=lf

# Platform-specific scripts
/gradlew text eol=lf
*.bat text eol=crlf

# Binary files
*.jar binary
*.png binary
*.jpg binary
*.gif binary
